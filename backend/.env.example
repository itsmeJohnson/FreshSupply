# FreshSupply Backend Environment Configuration
PORT=5001
NODE_ENV=production

# PostgreSQL Managed Database Connection String (e.g. Neon, Supabase, Railway)
# For serverless, ensure sslmode=require and use pooled connection string
DATABASE_URL=postgresql://user:password@host.provider.tech/freshsupply_db?sslmode=require

# JWT Secret for Staff and Customer authentication tokens
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_characters

# Local / S3 upload directory
UPLOAD_DIR=uploads
